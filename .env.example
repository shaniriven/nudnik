# Database (Railway Postgres — shared by both bot and scan-cron services)
DATABASE_URL=

# Test database (local Dockerized Postgres, used only when running `npm test`)
TEST_DATABASE_URL=

# Telegram
TELEGRAM_BOT_TOKEN=

# Claude API (extraction)
CLAUDE_API_KEY=

# Google OAuth2 — two separate accounts, two separate grants:
# Sheets/Drive run under the bar's own Google account.
SHEETS_OAUTH_CLIENT_ID=
SHEETS_OAUTH_CLIENT_SECRET=
SHEETS_OAUTH_REFRESH_TOKEN=

# Test Sheet target (separate from GOOGLE_SHEET_ID below, used only when running `npm test`/integration checks)
TEST_GOOGLE_SHEET_ID=

# Gmail runs under the owner's personal mailbox — a distinct OAuth grant, added in step 3.
# GMAIL_OAUTH_CLIENT_ID=
# GMAIL_OAUTH_CLIENT_SECRET=
# GMAIL_OAUTH_REFRESH_TOKEN=

# Google Sheets / Drive targets
GOOGLE_SHEET_ID=
GOOGLE_DRIVE_ZREPORTS_FOLDER_ID=

# Role invite codes (shared code per role — rotate when staff with access leaves)
ADMIN_INVITE_CODE=
WORKER_INVITE_CODE=

# Bar-specific config (see docs/architecture.md section 4a — required for replicating to a new bar)
BAR_NAME=Sasson
DEFAULT_CURRENCY=ILS
BAR_TIMEZONE=Asia/Jerusalem
GMAIL_SCAN_QUERY=

# Runtime
NODE_ENV=development
